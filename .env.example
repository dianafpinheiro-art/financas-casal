# ============================================================
# CONFIGURAÇÃO LOCAL — copie pra .env.local e preencha
# ============================================================
# NÃO commita .env.local no git! (já tá no .gitignore)

# Supabase (https://supabase.com/dashboard → seu projeto → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxx

# Service Role (apenas pra API routes server-side, NUNCA expor no client)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (https://console.anthropic.com → Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# URL pública do app (em dev fica http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
